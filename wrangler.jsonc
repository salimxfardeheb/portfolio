{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salimxfardeheb",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-23",
  "assets": {
    // Généré par `next build` (output: "export")
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Seul POST /api/contact passe par le Worker ; tout le reste est servi par les assets.
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "EMAIL",
      // Expéditeur verrouillé sur l'adresse du domaine.
      "allowed_sender_addresses": ["formulaire@salimxfardeheb.com"],
      // `wrangler dev` envoie de vrais emails (sinon il les simule dans un fichier local).
      "remote": true
    }
  ],
  "vars": {
    "SENDER_EMAIL": "formulaire@salimxfardeheb.com"
  },
  // DESTINATION_EMAIL (ton adresse vérifiée dans Email Routing) n'est PAS ici :
  //   - en production : `npx wrangler secret put DESTINATION_EMAIL`
  //   - en local      : fichier `.dev.vars` (ignoré par git), voir `.dev.vars.example`
  // Custom Domain : Cloudflare crée l'enregistrement DNS et le certificat HTTPS au déploiement.
  // www → apex se fait par une Redirect Rule (voir DEPLOY.md § 4).
  "routes": [{ "pattern": "salimxfardeheb.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
